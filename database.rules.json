{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "definitions": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "proposals": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['term','def']) && newData.child('term').isString() && newData.child('term').val().length <= 120 && newData.child('def').isString() && newData.child('def').val().length <= 2000"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.child('message').val().length <= 1000"
      }
    },
    "events": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['t','d','a']) && newData.child('t').val().length <= 16 && newData.child('a').val().length <= 40"
      }
    },
    "profiles": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && auth.uid === $uid && (!data.exists() || !newData.exists())) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        "lastSeen": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "plan": {
          ".validate": "newData.val() === 'free' || (auth != null && root.child('admins').child(auth.uid).val() === true)"
        },
        "$other": {
          ".validate": "$other === 'createdAt' || $other === 'plan' || $other === 'lastSeen'"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren() || !newData.exists()"
      }
    },
    "audit": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['t','type','label','who'])",
        "t": {
          ".validate": "newData.isNumber()"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "label": {
          ".validate": "newData.isString() && newData.val().length <= 220"
        },
        "who": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "meta": {
          ".validate": "newData.val() == null || newData.hasChildren() || newData.isString()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "interest": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['a','t','s'])",
        "a": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "s": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "$other": {
          ".validate": "false"
        }
      }
    }
  }
}